  g4 = nand g3 i1   # nand of the and
  g5 = nand g4 g4   # not a and b
  g6 = nand g2 g2   # not a
  g7 = nand g5 g5   # not b
  g8 = nand g6 g7   # xor = (a and not b) or (not a and b)
  g9 = nand i0 i1   # nand of the and
  g10 = nand g9 g9   # carry = a and b
  out g8 g10
end

